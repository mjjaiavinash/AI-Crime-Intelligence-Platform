# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=AI Crime Intelligence Platform
APP_VERSION=1.0.0
DEBUG=true

# ── MySQL ─────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ── Roles ─────────────────────────────────────────────────────────────────────
# admin         — full platform access, user management, all operations
# supervisor    — manage investigations, view all data, assign officers
# investigator  — create/update FIRs, manage evidence (default role)
# crime_analyst — read-only analytics, generate AI intelligence reports

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=../database/chromadb
CHROMA_COLLECTION_NAME=crime_documents

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=../uploads
MAX_UPLOAD_MB=20
