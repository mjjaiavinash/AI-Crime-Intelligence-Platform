{
  "project": {
    "project_name": "ai-crime-intelligence-platform",
    "platform_type": "AppSail"
  },
  "services": [
    {
      "name": "backend",
      "type": "AppSail",
      "stack": "python3.9",
      "memory": 1024,
      "instances": 1,
      "port": 8000,
      "build_command": "pip install -r requirements.txt",
      "run_command": "bash startup.sh",
      "root_dir": ".",
      "env_variables": {
        "APP_ENV": "production",
        "PYTHONPATH": "/app:/app/backend"
      }
    }
  ],
  "web": {
    "client": {
      "path": "client"
    }
  }
}
