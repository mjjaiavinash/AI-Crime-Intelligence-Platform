# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=AI Crime Intelligence Platform
APP_VERSION=1.0.0
DEBUG=false

# ── MySQL (Zoho Catalyst Cloud Scale DB or external) ──────────────────────────
DB_HOST=<your-catalyst-db-host>
DB_PORT=3306
DB_NAME=crime_intelligence
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=<generate-strong-secret-32-chars>
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=/tmp/chromadb
CHROMA_COLLECTION_NAME=crime_documents

# ── CORS (update with your Catalyst frontend URL) ─────────────────────────────
ALLOWED_ORIGINS=["https://<your-app>.catalystappsecure.com","https://<your-custom-domain>"]

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/uploads
MAX_UPLOAD_MB=20
