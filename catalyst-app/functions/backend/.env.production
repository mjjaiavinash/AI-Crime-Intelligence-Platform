# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=AI Crime Intelligence Platform
APP_VERSION=1.0.0
DEBUG=false

# ── MySQL (Zoho Catalyst Cloud Scale DB) ──────────────────────────────────────
DB_HOST=<your-catalyst-db-host>
DB_PORT=3306
DB_NAME=crime_intelligence
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<generate-strong-secret-64-chars>
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# ── ChromaDB (writable /tmp on Catalyst) ──────────────────────────────────────
CHROMA_PERSIST_DIR=/tmp/chromadb
CHROMA_COLLECTION_NAME=crime_documents

# ── CORS (update with your actual Catalyst app URL) ───────────────────────────
ALLOWED_ORIGINS=["https://<your-app>.catalystappsecure.com"]

# ── Uploads (writable /tmp on Catalyst) ───────────────────────────────────────
UPLOAD_DIR=/tmp/uploads
MAX_UPLOAD_MB=20

# ── HuggingFace / sentence-transformers cache ─────────────────────────────────
HF_HOME=/tmp/hf_cache
TRANSFORMERS_CACHE=/tmp/hf_cache
